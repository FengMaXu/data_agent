# Landing-only static build (npm run build:landing): no backend, so "get started" opens the desktop download panel.
# The installer is attached to each GitHub release; a mirror only needs these two URLs changed.
VITE_DOWNLOAD_URL=https://github.com/FengMaXu/yourdb/releases/latest/download/yourDB-Setup.exe
VITE_RELEASES_URL=https://github.com/FengMaXu/yourdb/releases
