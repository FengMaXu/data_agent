{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-agent.local/schemas/spider2-spec-quality-label.json",
  "title": "Spider2 题面到 Answer Spec 质量标签",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "labelVersion",
    "instanceId",
    "question",
    "questionSha256",
    "annotationStatus",
    "evidence",
    "facets",
    "review"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "labelVersion": { "type": "integer", "minimum": 1 },
    "instanceId": { "type": "string", "minLength": 1 },
    "database": { "type": "string" },
    "question": { "type": "string", "minLength": 1 },
    "questionSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "annotationStatus": {
      "enum": ["pending_manual", "prefilled_structural", "draft", "reviewed", "adjudicated"]
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datasetPath": { "type": "string" },
        "goldDir": { "type": "string" },
        "datasetSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "goldSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "labelsSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "generator": { "type": "string" }
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output",
        "grain",
        "measure",
        "denominator",
        "ranking",
        "time",
        "unit",
        "rounding",
        "joins",
        "filters",
        "ambiguity"
      ],
      "properties": {
        "output": { "$ref": "#/$defs/outputFacet" },
        "grain": { "$ref": "#/$defs/facet" },
        "measure": { "$ref": "#/$defs/facet" },
        "denominator": { "$ref": "#/$defs/facet" },
        "ranking": { "$ref": "#/$defs/facet" },
        "time": { "$ref": "#/$defs/facet" },
        "unit": { "$ref": "#/$defs/facet" },
        "rounding": { "$ref": "#/$defs/facet" },
        "joins": { "$ref": "#/$defs/facet" },
        "filters": { "$ref": "#/$defs/filterFacet" },
        "ambiguity": { "$ref": "#/$defs/facet" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotators", "adjudicator", "notes"],
      "properties": {
        "annotators": { "type": "array", "items": { "type": "string" } },
        "adjudicator": { "type": ["string", "null"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "enum": ["question", "task_document", "schema", "gold_shape", "gold_sql", "annotator_inference"] },
        "path": { "type": "string" },
        "quote": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "facet": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "alternatives", "evidenceRefs"],
      "properties": {
        "status": {
          "enum": ["pending_manual", "prefilled_structural", "draft", "reviewed", "adjudicated"]
        },
        "alternatives": { "type": "array", "items": { "type": "object" } },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "note": { "type": "string" }
      }
    },
    "outputFacet": {
      "allOf": [
        { "$ref": "#/$defs/facet" },
        {
          "properties": {
            "alternatives": {
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rowMode", "rowCount", "columnCount", "columnNames", "evidenceRefs"],
                "properties": {
                  "rowMode": { "enum": ["unknown", "scalar", "top_n", "grouped", "full", "detail"] },
                  "binding": { "enum": ["hard", "hypothesis", "ambiguity", "unknown", "structural"] },
                  "rowCount": { "type": "integer", "minimum": 0 },
                  "columnCount": { "type": "integer", "minimum": 0 },
                  "columnNames": { "type": "array", "items": { "type": "string" } },
                  "columnRoles": { "type": "array", "items": { "type": "object" } },
                  "evidenceRefs": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      ]
    },
    "filterFacet": {
      "allOf": [
        { "$ref": "#/$defs/facet" },
        {
          "required": ["required", "forbidden"],
          "properties": {
            "required": { "type": "array", "items": { "type": "object" } },
            "forbidden": { "type": "array", "items": { "type": "object" } }
          }
        }
      ]
    }
  }
}
