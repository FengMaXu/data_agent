        "path": "measure.formula",
        "status": "assumed",
        "value": {
          "op": "custom",
          "description": "Step1: per customer per calendar month of 2020, month-end balance = SUM(amount of deposits) - SUM(amount of withdrawals) in that month. Step2: per month, count customers whose month-end balance > 0. Step3: pick the month with the maximum count and the month with the minimum count. Step4: for those two months, average month-end balance across customers = SUM(month-end balances)/denominator (per population.eligibility). Step5: result = average of the max-count month minus average of the min-count month."
        }
      },
