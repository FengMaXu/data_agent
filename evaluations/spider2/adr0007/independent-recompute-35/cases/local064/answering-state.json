      "contentHash": "2fdfa03fd945860dc7a5b30ab7d1d290ce82f0fc77be84a2be27cb554b7001ed",
      "sql": "WITH RECURSIVE months(m) AS (SELECT '2020-01-01' UNION ALL SELECT date(m,'+1 month') FROM months WHERE m<'2020-12-01'), customers AS (SELECT DISTINCT customer_id FROM customer_nodes), net AS (SELECT customer_id,date(txn_date,'start of month') m,SUM(CASE WHEN txn_type='deposit' THEN txn_amount WHEN txn_type='withdrawal' THEN -txn_amount ELSE 0 END) balance FROM customer_transactions WHERE txn_date>='2020-01-01' AND txn_date<'2021-01-01' GROUP BY customer_id,m), spine AS (SELECT c.customer_id,m.m,COALESCE(n.balance,0) balance FROM customers c CROSS JOIN months m LEFT JOIN net n ON n.customer_id=c.customer_id AND n.m=m.m), stats AS (SELECT m,SUM(balance>0) positive_customers,AVG(balance) avg_balance,SUM(balance) total_net FROM spine GROUP BY m) , hi AS (SELECT * FROM stats ORDER BY positive_customers DESC,m LIMIT 1), lo AS (SELECT * FROM stats ORDER BY positive_customers ASC,m LIMIT 1) SELECT hi.m highest_month,hi.positive_customers highest_count,hi.avg_balance highest_average,lo.m lowest_month,lo.positive_customers lowest_count,lo.avg_balance lowest_average,hi.avg_balance-lo.avg_balance difference FROM hi CROSS JOIN lo",
