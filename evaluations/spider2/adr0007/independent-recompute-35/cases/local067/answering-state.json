      "contentHash": "a942e969952f7d2b7b1f7baf704e31b996144e78f0ee1afb52829b8d537c7459",
      "sql": "WITH december AS (SELECT s.* FROM sales s JOIN times t ON t.time_id=s.time_id JOIN customers c ON c.cust_id=s.cust_id JOIN countries n ON n.country_id=c.country_id WHERE n.country_name='Italy' AND t.calendar_year=2021 AND t.calendar_month_number=12),lines AS (SELECT d.*,k.unit_cost,k.unit_price,d.amount_sold-d.quantity_sold*k.unit_cost line_profit,d.quantity_sold*(k.unit_price-k.unit_cost) list_profit FROM december d LEFT JOIN costs k ON k.prod_id=d.prod_id AND k.time_id=d.time_id AND k.channel_id=d.channel_id AND k.promo_id=d.promo_id),customer_profit AS (SELECT cust_id,SUM(line_profit) profit,SUM(list_profit) profit_by_list_price,COUNT(*) sale_rows FROM lines GROUP BY cust_id) ,tiers AS (SELECT cust_id,profit,NTILE(10) OVER(ORDER BY profit,cust_id) tier FROM customer_profit) SELECT tier,MAX(profit) highest_profit,MIN(profit) lowest_profit FROM tiers GROUP BY tier ORDER BY tier",
      "queryHash": "b2b0acd90e6bddb2db517cb4c1ad43081ac578993e33054afd8cd6ac9ba29f5f",
