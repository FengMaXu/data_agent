      ],
      "rowCount": 1,
      "contentHash": "e11d082d723f04ad62b8328d28b03cdfaba2fa372a9d7e1b80a08ea251d4a6a3",
      "sql": "WITH RECURSIVE net AS (SELECT customer_id,date(txn_date,'start of month') m,SUM(CASE WHEN txn_type='deposit' THEN txn_amount ELSE -txn_amount END) net FROM customer_transactions WHERE txn_type IN ('deposit','withdrawal') GROUP BY customer_id,m), bounds AS (SELECT customer_id,MIN(m) first_m,MAX(m) last_m FROM net GROUP BY customer_id), spine(customer_id,m,last_m) AS (SELECT customer_id,first_m,last_m FROM bounds UNION ALL SELECT customer_id,date(m,'+1 month'),last_m FROM spine WHERE m<last_m), filled AS (SELECT s.customer_id,s.m,s.last_m,COALESCE(n.net,0) net FROM spine s LEFT JOIN net n ON s.customer_id=n.customer_id AND s.m=n.m), closing AS (SELECT *,SUM(net) OVER(PARTITION BY customer_id ORDER BY m ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) balance FROM filled), previous AS (SELECT *,LAG(balance,1,0) OVER(PARTITION BY customer_id ORDER BY m) prior_balance FROM closing), latest AS (SELECT *,CASE WHEN prior_balance=0 THEN balance*100.0 ELSE (balance-prior_balance)*100.0/prior_balance END growth FROM previous WHERE m=last_m) SELECT 100.0*SUM(growth>5)/COUNT(*) percentage_customers FROM latest",
      "queryHash": "67f6ab61f482fb038d5063c4e11c0d8fdd996e1f6b6455ed5d31d7f0dad01ba0",
