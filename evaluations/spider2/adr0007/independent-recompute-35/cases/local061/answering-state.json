      "rowCount": 12,
      "contentHash": "b3b017f8bd5c846a14ec07123b73de2e0c0a25da9943c28b484d1091ce0066b2",
      "sql": "WITH hist AS (SELECT s.prod_id,t.calendar_year yr,t.calendar_month_number month,SUM(s.amount_sold) sales_amount FROM sales s JOIN times t ON t.time_id=s.time_id JOIN customers c ON c.cust_id=s.cust_id JOIN countries cn ON cn.country_id=c.country_id JOIN channels ch ON ch.channel_id=s.channel_id JOIN promotions pm ON pm.promo_id=s.promo_id WHERE cn.country_name='France' AND ch.channel_total_id=1 AND pm.promo_total_id=1 AND t.calendar_year IN (2019,2020) GROUP BY s.prod_id,t.calendar_year,t.calendar_month_number), projections AS (SELECT b.prod_id,b.month,a.sales_amount s19,b.sales_amount s20,b.sales_amount*(1+(b.sales_amount-a.sales_amount)/a.sales_amount) local_forecast FROM hist a JOIN hist b ON a.prod_id=b.prod_id AND a.month=b.month AND a.yr=2019 AND b.yr=2020 WHERE a.sales_amount>0),usd AS (SELECT p.*,COALESCE(c.to_us,1) rate,p.local_forecast*COALESCE(c.to_us,1) usd_forecast FROM projections p LEFT JOIN currency c ON c.country='France' AND c.year=2021 AND c.month=p.month) SELECT month,ROUND(AVG(usd_forecast),2) average_projected_monthly_sales_usd FROM usd GROUP BY month ORDER BY month",
      "queryHash": "39837d61f5497c5e0a8ad7dc95df2998f6d87004b873b95436c59b30809cabdf",
