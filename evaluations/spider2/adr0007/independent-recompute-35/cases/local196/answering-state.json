      "sql": "WITH totals AS MATERIALIZED(SELECT customer_id,SUM(amount) total_spent FROM payment GROUP BY customer_id),rentals AS MATERIALIZED(SELECT customer_id,COUNT(DISTINCT rental_id)-1 subsequent_rentals FROM rental GROUP BY customer_id),first_payment AS MATERIALIZED(SELECT customer_id,rental_id,ROW_NUMBER() OVER(PARTITION BY customer_id ORDER BY payment_date,payment_id) seq FROM payment),first_rating AS MATERIALIZED(SELECT p.customer_id,f.rating FROM first_payment p JOIN rental r ON p.rental_id=r.rental_id JOIN inventory i ON r.inventory_id=i.inventory_id JOIN film f ON i.film_id=f.film_id WHERE p.seq=1),per_customer AS(SELECT f.customer_id,f.rating,t.total_spent,r.subsequent_rentals FROM first_rating f JOIN totals t USING(customer_id) JOIN rentals r USING(customer_id)) SELECT rating,AVG(total_spent) average_total_spent,AVG(subsequent_rentals*1.0) average_subsequent_rentals FROM per_customer GROUP BY rating ORDER BY rating",
