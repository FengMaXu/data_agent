      "sql": "WITH scores AS (SELECT name,version,step,MAX(CASE WHEN model<>'Stack' THEN test_score END) baseline,MAX(CASE WHEN model='Stack' THEN test_score END) stack_score FROM model_score GROUP BY name,version,step), step_status AS (SELECT name,version,step,CASE WHEN baseline<stack_score THEN 'strong' WHEN baseline=stack_score THEN 'soft' END status FROM scores), units AS (SELECT DISTINCT m.name,m.version,m.L1_model,s.status FROM model m JOIN step_status s ON s.name=m.name AND s.version=m.version AND s.step=m.step WHERE s.status IS NOT NULL AND m.L1_model IS NOT NULL), counts AS (SELECT L1_model,status,COUNT(*) occurrences FROM units GROUP BY L1_model,status) SELECT status,L1_model,occurrences FROM counts c WHERE occurrences=(SELECT MAX(occurrences) FROM counts x WHERE x.status=c.status) ORDER BY status,L1_model",
