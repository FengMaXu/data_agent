      "rowCount": 1,
      "contentHash": "a399e54cc1b0c5574e076dc5551a874e175455e1f58980398edfee9e213e9bf7",
      "sql": "WITH dates AS (SELECT DISTINCT company_id,date_joined,year_founded FROM companies_dates), industries AS (SELECT DISTINCT company_id,industry FROM companies_industries), new_companies AS (SELECT d.company_id,CAST(strftime('%Y',d.date_joined) AS INTEGER) year,i.industry FROM dates d JOIN industries i USING(company_id) WHERE d.date_joined>='2019-01-01' AND d.date_joined<'2022-01-01'), totals AS (SELECT industry,count(distinct company_id) total FROM new_companies GROUP BY industry) SELECT industry,total/3.0 average_new_companies FROM totals ORDER BY total DESC,industry LIMIT 1",
      "queryHash": "8b9f04c9218cc2bb8908ab01f2ed225c1152bcdb19c4f0e10aea64091b8eee4c",
