      "contentHash": "14d1e3772d659783c9ebc03df62e70ac2ea43b257822bee5ec876caf60daa336",
      "sql": "WITH airports AS (SELECT airport_code,json_extract(city,'$.en') city,CAST(substr(coordinates,2,instr(coordinates,',')-2) AS REAL)*pi()/180 lng,CAST(substr(coordinates,instr(coordinates,',')+1,length(coordinates)-instr(coordinates,',')-1) AS REAL)*pi()/180 lat FROM airports_data), route_rows AS (SELECT f.flight_id,a.city from_city,b.city to_city,a.airport_code dep,b.airport_code arr,2*6371*asin(sqrt(min(1.0,max(0.0,pow(sin((a.lat-b.lat)/2),2)+cos(a.lat)*cos(b.lat)*pow(sin((a.lng-b.lng)/2),2))))) distance FROM flights f JOIN airports a ON f.departure_airport=a.airport_code JOIN airports b ON f.arrival_airport=b.airport_code), pairs AS (SELECT min(from_city,to_city) city1,max(from_city,to_city) city2,avg(distance) distance,count(*) flights FROM route_rows GROUP BY 1,2), bins(bucket) AS (VALUES(0),(1000),(2000),(3000),(4000),(5000),(6000)), counts AS (SELECT bucket,count(p.city1) pair_count FROM bins LEFT JOIN pairs p ON min(6000,cast(p.distance/1000 AS INTEGER)*1000)=bucket GROUP BY bucket) SELECT min(pair_count) fewest_pair_count FROM counts",
