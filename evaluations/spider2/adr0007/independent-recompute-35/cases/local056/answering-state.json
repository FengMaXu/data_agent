      "sql": "WITH m AS (SELECT customer_id,strftime('%Y-%m',payment_date) month,SUM(amount) total,AVG(amount) mean FROM payment GROUP BY 1,2),d AS (SELECT *,LAG(total) OVER(PARTITION BY customer_id ORDER BY month) prev,LAG(mean) OVER(PARTITION BY customer_id ORDER BY month) prev_mean FROM m),s AS (SELECT customer_id,COUNT(prev) n,AVG(total-prev) signed_change,AVG(ABS(total-prev)) absolute_change,AVG((total-prev)*1.0/NULLIF(prev,0)) rate,AVG(mean-prev_mean) mean_change FROM d GROUP BY 1) SELECT c.first_name||' '||c.last_name full_name FROM s JOIN customer c USING(customer_id) WHERE signed_change=(SELECT MAX(signed_change) FROM s)",
