      "resultRef": "result_72c35452-35b7-4989-9850-310fd6299ab1",
      "resultSchema": [
        "sum_moving_averages"
      ],
      "rowCount": 1,
      "contentHash": "e4066e07b09e50721c86e2685d42b13fe2240fc6bbbe0a6f45cb758e31cb35c1",
      "sql": "WITH RECURSIVE calendar(d) AS (SELECT date('2017-01-01') UNION ALL SELECT date(d,'+1 day') FROM calendar WHERE d<'2018-08-29'), daily AS (SELECT date(o.order_purchase_timestamp) d, COUNT(*) units,SUM(i.price) revenue FROM orders o JOIN order_items i ON o.order_id=i.order_id JOIN products p ON i.product_id=p.product_id JOIN product_category_name_translation t ON p.product_category_name=t.product_category_name WHERE t.product_category_name_english='toys' AND date(o.order_purchase_timestamp) BETWEEN '2017-01-01' AND '2018-08-29' GROUP BY 1), train AS (SELECT c.d,julianday(c.d)-julianday('2017-01-01') x,coalesce(units,0) y,coalesce(revenue,0) revenue FROM calendar c LEFT JOIN daily USING(d)), stats AS (SELECT count(*) n,sum(x) sx,sum(y) sy,sum(x*x) sxx,sum(x*y) sxy,avg(x) mx,avg(y) my FROM train), model AS (SELECT (sxy-sx*sy/n)/(sxx-sx*sx/n) b,my-(sxy-sx*sy/n)/(sxx-sx*sx/n)*mx a FROM stats), forecast(d) AS (SELECT date('2018-12-03') UNION ALL SELECT date(d,'+1 day') FROM forecast WHERE d<'2018-12-10'), predictions AS (SELECT d,a+b*(julianday(d)-julianday('2017-01-01')) yhat FROM forecast CROSS JOIN model), smooth AS (SELECT c.d,avg(p.yhat) ma FROM predictions c JOIN predictions p ON p.d BETWEEN date(c.d,'-2 day') AND date(c.d,'+2 day') WHERE c.d BETWEEN '2018-12-05' AND '2018-12-08' GROUP BY c.d) SELECT sum(ma) sum_moving_averages FROM smooth",
      "queryHash": "ad41038866634e4e3dfb94294a609f5739cd62f829f0f22287aaa4700ed0cba7",
