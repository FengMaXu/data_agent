      "rowCount": 236,
      "contentHash": "a0140ddd0b3ef25409b384b31821ee442686be0d24416567e55a1ab717d7dde5",
      "sql": "WITH sales_by_seller AS (SELECT seller_id,COUNT(*) products_sold,SUM(price) total_sales,AVG(price) average_item_price FROM order_items GROUP BY seller_id HAVING COUNT(*)>100),seller_orders AS (SELECT DISTINCT seller_id,order_id FROM order_items WHERE seller_id IN (SELECT seller_id FROM sales_by_seller)),review_stats AS (SELECT so.seller_id,AVG(r.review_score*1.0) average_review_score,COUNT(r.review_score) reviews FROM seller_orders so LEFT JOIN order_reviews r ON r.order_id=so.order_id GROUP BY so.seller_id),pack_stats AS (SELECT so.seller_id,AVG(CASE WHEN julianday(o.order_delivered_carrier_date)>=julianday(o.order_approved_at) THEN julianday(o.order_delivered_carrier_date)-julianday(o.order_approved_at) END) average_packing_days,COUNT(CASE WHEN julianday(o.order_delivered_carrier_date)>=julianday(o.order_approved_at) THEN 1 END) packing_orders FROM seller_orders so JOIN orders o ON o.order_id=so.order_id GROUP BY so.seller_id),category_sales AS (SELECT i.seller_id,p.product_category_name,COALESCE(tr.product_category_name_english,p.product_category_name,'[unknown]') english,COUNT(*) units,SUM(i.price) revenue FROM order_items i JOIN products p ON p.product_id=i.product_id LEFT JOIN product_category_name_translation tr ON tr.product_category_name=p.product_category_name WHERE i.seller_id IN (SELECT seller_id FROM sales_by_seller) GROUP BY i.seller_id,p.product_category_name,english),top_categories AS (SELECT seller_id,GROUP_CONCAT(english,CHAR(59)||' ') top_category_english FROM (SELECT c.* FROM category_sales c WHERE units=(SELECT MAX(units) FROM category_sales d WHERE d.seller_id=c.seller_id) ORDER BY seller_id,english) GROUP BY seller_id) SELECT s.seller_id,s.total_sales,s.products_sold,s.average_item_price,r.average_review_score,p.average_packing_days,t.top_category_english FROM sales_by_seller s LEFT JOIN review_stats r USING(seller_id) LEFT JOIN pack_stats p USING(seller_id) LEFT JOIN top_categories t USING(seller_id) ORDER BY s.total_sales DESC,s.seller_id",
      "queryHash": "aedbb69c882f9513e189cedbc4679462d4a17c9f3bf6b9f1ed4a64d4d7c6f45d",
