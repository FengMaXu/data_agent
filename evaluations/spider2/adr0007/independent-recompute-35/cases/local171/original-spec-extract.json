            "value": {
              "name": "distinct legislator (male, from Louisiana)",
              "keyColumns": [
                "id_bioguide"
              ]
            },
            "basis": "request",
            "quote": "how many distinct legislators"
          },
          "population.eligibility": {
            "value": "纳入 legislators.gender='M' 且该 id_bioguide 在 legislators_terms 中存在至少一条 state='LA' 任期记录的议员；没有任期的议员不纳入。",
            "basis": "assumed",
            "rationale": "题面限定 male / from Louisiana；state 只存在于任期表，故以存在 LA 任期记录定义 'from Louisiana'；无任期记录者不可能在某日'actively serving'，故排除。"
          },
          "population.conditions": {
            "value": [
              "legislators.gender = 'M'",
              "该议员存在 legislators_terms.state = 'LA' 的任期记录"
            ],
            "basis": "assumed",
            "rationale": "gender='M' 与 state='LA' 的取值由数据观测确认；作用阶段为资格总体筛选(WHERE)。"
          },
          "population.source": {
            "value": {
              "tables": [
                "legislators",
                "legislators_terms"
              ],
              "note": "legislators 提供 gender；legislators_terms 提供 state/term_start/term_end；按 id_bioguide 连接。"
            },
            "basis": "assumed",
            "rationale": "gender 只在 legislators，state 与任期日期只在 legislators_terms。"
          },
          "population.time": {
            "value": {
              "expression": "对每位议员，取其首个任期起点年份 Y0；考察 Y = Y0+31 … Y0+49，参考日为每年 12 月 31 日；仅保留 (12-31 相对首个任期起点) 严格大于 30 年且严格小于 50 年的年份",
              "boundary": "exclusive"
            },
            "basis": "request",
            "quote": "on December 31 of each year from more than 30 years since their first term up to less than 50 years"
          },
          "population.timeField": {
            "value": "legislators_terms.term_start 用于求首个任期起点；legislators_terms.term_start/term_end 用于判断参考日是否在职区间内（两端含）。",
            "basis": "assumed",
            "rationale": "题面未指明物理列；任期表只有 term_start/term_end。"
          },
          "measure.formula": {
            "value": {
              "op": "count_distinct",
              "per": "elapsed_year",
              "of": "id_bioguide"
            },
            "basis": "request",
            "quote": "how many distinct legislators"
          },
          "measure.countGrain": {
            "value": "按议员实体 id_bioguide 去重计数（同一议员在同一 elapsed 年内只计一次）。",
            "basis": "request",
            "quote": "how many distinct legislators"
          },
          "grouping": {
            "value": [
              "自首个任期起的整年数 elapsed = YEAR(参考日 12-31) - YEAR(首个任期起点)，取值 31..49"
            ],
            "basis": "request",
            "quote": "grouping the results by the exact number of years elapsed since their first term"
          },
          "selection": {
            "value": "n/a"
          },
          "output": {
            "value": {
              "rowMode": "grouped",
              "columns": [
                "years_since_first_term",
