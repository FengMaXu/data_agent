{
  "name": "data-agent-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "frontend"
  ],
  "scripts": {
    "build:contracts": "npm run build --workspace=@data-agent/contracts",
    "build:runtime": "npm run build --workspace=@data-agent/runtime",
    "build:transport": "npm run build --workspace=@data-agent/transport",
    "build:electron-host": "npm run build --workspace=@data-agent/electron-host",
    "build:server": "npm run build --workspace=@data-agent/server",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build:contracts && npm run build:runtime && npm run build:transport && npm run build:electron-host && npm run build:server && npm run build:frontend",
    "build:distribution": "node scripts/build-distribution.mjs",
    "verify:architecture": "node scripts/verify-backend-architecture.mjs",
    "verify:backend": "npm run verify:architecture && npm run typecheck && npm run typecheck:negative --workspace=@data-agent/runtime && npm test && npm run build:distribution && node scripts/smoke-web-host.mjs",
    "verify:backend:packaged": "npm run verify:backend && node scripts/package-electron-manual.mjs frontend/release-final/win-unpacked && node scripts/smoke-electron.mjs frontend/release-final/win-unpacked",
    "eval:spider2": "node evaluations/spider2/run.mjs",
    "measure:spec": "npm run build:runtime && node evaluations/spider2/spec-quality.mjs",
    "measure:phase5-ab": "node evaluations/spider2/phase5-ab.mjs",
    "validate:spec-labels": "node evaluations/spider2/spec-quality.mjs",
    "test:eval:spider2": "node --test evaluations/spider2/lib.test.mjs evaluations/spider2/spec-quality.test.mjs evaluations/spider2/phase5-ab.test.mjs evaluations/spider2/baseline-report.test.mjs",
    "pretest": "npm run build",
    "test": "npm run test --workspaces --if-present",
    "pretypecheck": "npm run build",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "main": "electron-host/main.cjs"
}