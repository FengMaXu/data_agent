{
  "description": "Language-independent SQL safety contract fixtures shared by the legacy Python SQLGuard (src/mcp/sql_guard.py) and the TypeScript SqlGuard (packages/runtime/src/sql-guard.ts). Each case asserts the externally visible guard decision.",
  "cases": [
    { "name": "empty", "sql": "", "allowed": false, "reasonContains": "Empty query" },
    { "name": "whitespace-only", "sql": "   \n\t  ", "allowed": false, "reasonContains": "Empty query" },
    { "name": "simple select", "sql": "SELECT * FROM users", "allowed": true },
    { "name": "cte select", "sql": "WITH t AS (SELECT 1 AS x) SELECT x FROM t", "allowed": true },
    { "name": "drop table", "sql": "DROP TABLE users", "allowed": false, "reasonContains": "high-risk" },
    { "name": "truncate", "sql": "TRUNCATE TABLE logs", "allowed": false, "reasonContains": "high-risk" },
    { "name": "delete", "sql": "DELETE FROM users WHERE id = 1", "allowed": false, "reasonContains": "high-risk" },
    { "name": "insert", "sql": "INSERT INTO t VALUES (1)", "allowed": false, "reasonContains": "high-risk" },
    { "name": "update", "sql": "UPDATE t SET a = 1", "allowed": false, "reasonContains": "high-risk" },
    { "name": "alter", "sql": "ALTER TABLE t ADD COLUMN c INT", "allowed": false, "reasonContains": "high-risk" },
    { "name": "create", "sql": "CREATE INDEX ix ON t(a)", "allowed": false, "reasonContains": "high-risk" },
    { "name": "grant", "sql": "GRANT ALL ON db.* TO 'u'@'%'", "allowed": false, "reasonContains": "high-risk" },
    { "name": "revoke", "sql": "REVOKE ALL ON db.* FROM 'u'@'%'", "allowed": false, "reasonContains": "high-risk" },
    { "name": "call procedure", "sql": "CALL monthly_rollup()", "allowed": false, "reasonContains": "high-risk" },
    { "name": "replace into", "sql": "REPLACE INTO t SELECT * FROM u", "allowed": false, "reasonContains": "high-risk" },
    { "name": "rename table", "sql": "RENAME TABLE a TO b", "allowed": false, "reasonContains": "high-risk" },
    { "name": "load data", "sql": "LOAD DATA INFILE 'x.csv' INTO TABLE t", "allowed": false, "reasonContains": "high-risk" },
    { "name": "into outfile", "sql": "SELECT * FROM t INTO OUTFILE '/tmp/x'", "allowed": false, "reasonContains": "high-risk" },
    { "name": "into dumpfile", "sql": "SELECT * FROM t INTO DUMPFILE '/tmp/x'", "allowed": false, "reasonContains": "high-risk" },
    { "name": "multi-statement injection", "sql": "SELECT 1; DROP TABLE users", "allowed": false, "reasonContains": "injection" },
    { "name": "block comment hides keyword", "sql": "SELECT /* DROP */ * FROM t", "allowed": false, "reasonContains": "injection" },
    { "name": "union select", "sql": "SELECT a FROM t UNION SELECT b FROM u", "allowed": false, "reasonContains": "injection" },
    { "name": "union all select", "sql": "SELECT a FROM t UNION ALL SELECT b FROM u", "allowed": false, "reasonContains": "injection" },
    { "name": "exec", "sql": "EXEC sp_configure", "allowed": false, "reasonContains": "injection" },
    { "name": "xp_cmdshell", "sql": "EXEC xp_cmdshell 'dir'", "allowed": false, "reasonContains": "injection" },
    { "name": "line comment allowed", "sql": "SELECT * FROM t -- trailing note", "allowed": true },
    { "name": "case-insensitive keyword", "sql": "select * from t where a in (select b from u) drop database x", "allowed": false, "reasonContains": "high-risk" },
    { "name": "keyword inside identifier is not blocked", "sql": "SELECT * FROM dropped_items", "allowed": true },
    { "name": "standalone keyword after identifier", "sql": "SELECT * FROM items; DROP TABLE items", "allowed": false, "reasonContains": "injection" },
    { "name": "aggregation select", "sql": "SELECT region, SUM(amount) AS total FROM sales GROUP BY region ORDER BY total DESC", "allowed": true },
    { "name": "parameterized-looking select", "sql": "SELECT * FROM orders WHERE customer_id = ?", "allowed": true }
  ]
}
