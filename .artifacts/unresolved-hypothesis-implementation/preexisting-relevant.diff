+const ASSURANCE_HOOK_NAMES = ["informOnQuery", "interpretationsOnAnomaly", "integrityBlocks", "terminateAfterExport"];
+const DEFAULT_TIER_A_DETECTORS = ["join_fanout", "unauthorized_filter", "intermediate_candidate", "empty_after_filter"];
+const DEFAULT_TIER_B_DETECTORS = ["count_distinct_divergence", "entity_population_mismatch", "cross_period_set_mismatch", "physical_bound_violation", "null_like_member_in_filter", "shape_mismatch", "fingerprint_unchanged"];
+
+function assuranceHookSwitches(config, options = {}) {
+  const configured = config.assurance?.hooks ?? {};
+  const switches = Object.fromEntries(ASSURANCE_HOOK_NAMES.map((name) => [name, configured[name] !== false]));
+  if (options.disableHook !== undefined) {
+    if (!ASSURANCE_HOOK_NAMES.includes(options.disableHook)) throw new Error(`UNKNOWN_ASSURANCE_HOOK:${options.disableHook}`);
+    switches[options.disableHook] = false;
+  }
+  return switches;
+}
+
+function detectorPolicyFromConfig(config) {
+  const configured = config.assurance?.detectors ?? {};
+  const disabled = [...new Set(Array.isArray(configured.disabled) ? configured.disabled.map(String) : [])];
+  const disabledSet = new Set(disabled);
+  const tierA = [...new Set(Array.isArray(configured.tierA) ? configured.tierA.map(String) : DEFAULT_TIER_A_DETECTORS)].filter((detector) => !disabledSet.has(detector));
+  const tierB = [...new Set(Array.isArray(configured.tierB) ? configured.tierB.map(String) : DEFAULT_TIER_B_DETECTORS)].filter((detector) => !disabledSet.has(detector) && !tierA.includes(detector));
+  return { enabled: configured.enabled !== false, tierA, tierB, disabled };
+}
+
+function interpretationPolicyFromConfig(config) {
+  const configured = config.assurance?.interpretations ?? {};
+  const triggerTiers = Array.isArray(configured.triggerTiers) ? configured.triggerTiers.filter((tier) => tier === "A" || tier === "B") : ["A"];
+  return {
+    triggerTiers,
+    maxCyclesPerTask: Math.max(0, Number(configured.maxCyclesPerTask ?? 1)),
+    minRemainingTurns: Math.max(0, Number(configured.minRemainingTurns ?? 6)),
+    minRemainingToolCalls: Math.max(0, Number(configured.minRemainingToolCalls ?? 10)),
+    dirtyDataAction: config.assurance?.dirtyDataAction === "ask_user" ? "ask_user" : "multi_candidate",
+  };
+}
+
+function resumeStatusesFromOptions(options) {
+  const raw = options.resumeStatuses === undefined ? "provider_error,resource_error,error" : String(options.resumeStatuses);
+  const statuses = raw.split(",").map((status) => status.trim()).filter(Boolean);
+  if (!statuses.length) throw new Error("RESUME_STATUSES_REQUIRED");
+  return new Set(statuses);
+}
