# ─── AI 模型配置 ───
# OpenAI API Key（使用 GPT 系列模型时需要）
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key（使用 Claude 系列模型时需要）
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# 默认模型（支持 gpt-4o-mini, gpt-4o, claude-3-5-sonnet-20241022 等）
DEFAULT_MODEL=gpt-4o-mini
TEMPERATURE=0.0
MAX_TOKENS=4096

# ─── MCP Server 配置 ───
# MCP Server 启动命令
MCP_SERVER_COMMAND=python
# MCP Server 脚本路径（绝对路径）
MCP_SERVER_SCRIPT=d:/database_agent/mysql_mcp_server/server.py

# ─── 数据库配置（传递给 MCP Server） ───
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=your-database
