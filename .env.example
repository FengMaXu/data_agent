# ─── AI 模型配置 ───
# OpenAI API Key（使用 GPT 系列模型时需要）
OPENAI_API_KEY=sk-your-openai-key-here

# 可选：自定义 OpenAI 兼容网关地址（留空使用官方端点）
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API Key（使用 Claude 系列模型时需要）
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# 默认模型（支持 gpt-4o-mini, gpt-4o, claude-3-5-sonnet-20241022 等）
DEFAULT_MODEL=gpt-4o-mini
TEMPERATURE=0.0
MAX_TOKENS=4096

# ─── 可选：Jev 歧义假设比较 ───
# 仅配置后注册 compare_hypotheses；默认固定版本以便校准和回放。
# TYPESAFE_API_KEY=your-typesafe-key
# TYPESAFE_MODEL=jev-1.13.0
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
# TYPESAFE_SPEC_ALIGNMENT=1  # 显式启用提交后 Answer Spec 反馈；不由 compare_hypotheses 自动开启

# ─── MCP Server 配置 ───
# MCP Server 启动命令
MCP_SERVER_COMMAND=python
# MCP Server 脚本路径（绝对路径）
MCP_SERVER_SCRIPT=d:/database_agent/mysql_mcp_server/server.py

# ─── 数据库配置（传递给 MCP Server） ───
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=your-database

# 飞书渠道（ADR-0011，可选）：配置后 Web Host 通过长连接接入飞书机器人，不需要公网地址。
# 开放平台需开启机器人能力，订阅事件 im.message.receive_v1，配置回调 card.action.trigger，
# 并在“事件与回调”中选择“使用长连接接收”。
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# 允许在群内直接展示结果的群 chat_id（逗号分隔）；未列出的群，结果私聊发给提问人。
# FEISHU_GROUP_DELIVERY_CHATS=oc_xxx,oc_yyy
# 海外版 Lark 设为 lark
# FEISHU_DOMAIN=feishu
# 看板以截图发到手机，需要本机有 Edge 或 Chrome；不在默认安装位置时指定路径
# DATA_AGENT_SNAPSHOT_BROWSER=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
