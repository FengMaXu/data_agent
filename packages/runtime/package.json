{
  "name": "@data-agent/runtime",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/write-build-provenance.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:negative": "tsc -p tsconfig.type-tests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@data-agent/contracts": "0.1.0",
    "@earendil-works/chord": "0.85.1",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-telemetry": "0.85.1",
    "better-sqlite3": "^12.10.0",
    "echarts": "^6.1.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
