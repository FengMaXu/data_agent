# 全部阶段完成总结（含新增工作区 & 外部生态）

## 项目架构

```mermaid
graph TB
    User["用户"] --> CLI["main.py CLI"]
    CLI --> Loop["Agent Loop<br/>事件驱动双循环引擎<br/>Steering / Follow-up"]
    Loop --> Gateway["AI Gateway<br/>OpenAI / Anthropic"]
    Loop --> Tools

    subgraph Tools["18+ 个 Agent 工具"]
        direction LR
        subgraph CTX["上下文引擎"]
            T1["introspect_database"]
            T2["get_table_detail"]
            T3["search_business_context"]
            T4["search_query_patterns"]
        end
        subgraph DB["数据库执行"]
            T5["list_tables"]
            T6["get_table_schema"]
            T7["execute_sql 沙盒"]
        end
        subgraph WS["工作区 NEW"]
            W1["list_workspace"]
            W2["read_workspace_file"]
            W3["write_workspace_file"]
            W4["run_python"]
        end
        subgraph ECO["外部生态 NEW"]
            E1["api_* HTTP Hooks"]
            E2["MCP桥接工具"]
        end
        subgraph INT["交互"]
            T8["request_user_clarification"]
            T9["export_csv / summarize"]
        end
        subgraph LEARN["学习记忆"]
            T11["search_past_learnings"]
            T12["save_learning"]
            T13["report_query_feedback"]
        end
    end

    T7 --> Guard["SQL Guard 安全拦截"]
    T7 --> Eval["SQL Evaluator LIMIT 1"]
    Guard --> MCP_DB["MCP Client"]
    Eval --> MCP_DB
    MCP_DB --> Server["MySQL MCP Server<br/>独立进程"]
    Server --> MySQL[("MySQL")]

    W4 --> Sandbox["Python 子进程沙盒<br/>Pandas / Matplotlib"]
    Sandbox --> WS_FS["工作区文件系统<br/>data/ scripts/ output/"]
    W1 & W2 & W3 --> WS_FS

    E1 --> ExtAPI["外部 REST API<br/>天气 / 汇率 / ..."]
    E2 --> MCPReg["Universal MCP Registry"]
    MCPReg --> ExtMCP1["知识库 MCP Server"]
    MCPReg --> ExtMCP2["搜索 MCP Server"]
```

